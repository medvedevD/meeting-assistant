{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meeting-assistant",
  "version": "0.1.0",
  "identifier": "dev.codemedvedev.meeting-assistant",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Meeting Assistant",
        "width": 640,
        "height": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
