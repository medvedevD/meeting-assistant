{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meeting-assistant",
  "version": "0.1.0",
  "identifier": "dev.codemedvedev.meeting-assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meeting Assistant",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      },
      {
        "label": "debug",
        "title": "Diagnostics",
        "url": "debug.html",
        "visible": false,
        "width": 860,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
